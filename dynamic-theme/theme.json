{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"palette": [
				{ "slug": "base", "color": "#0F0E0D", "name": "Base" },
				{ "slug": "surface", "color": "#1A1918", "name": "Surface" },
				{ "slug": "surface-raised", "color": "#262320", "name": "Surface raised" },
				{ "slug": "contrast", "color": "#F6F4F1", "name": "Contrast" },
				{ "slug": "muted", "color": "#A39C93", "name": "Muted" },
				{ "slug": "accent", "color": "#F5C518", "name": "Accent" },
				{ "slug": "accent-bright", "color": "#FFDC5C", "name": "Accent bright" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Barlow Condensed\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Barlow Condensed",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/barlow-condensed-600.woff2" ]
						},
						{
							"fontFamily": "Barlow Condensed",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/barlow-condensed-700.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-variable.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.1875rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.75rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "3.5rem", "fluid": { "min": "2.5rem", "max": "4.5rem" } },
				{ "slug": "display", "name": "Display", "size": "5rem", "fluid": { "min": "3rem", "max": "6.5rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "clamp(0.75rem, 1.5vw, 1rem)" },
				{ "slug": "30", "name": "2", "size": "clamp(1.25rem, 2.5vw, 1.75rem)" },
				{ "slug": "40", "name": "3", "size": "clamp(1.75rem, 3.5vw, 2.5rem)" },
				{ "slug": "50", "name": "4", "size": "clamp(2.5rem, 5vw, 3.75rem)" },
				{ "slug": "60", "name": "5", "size": "clamp(3.5rem, 7vw, 5rem)" }
			]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"shadow": { "defaultPresets": false }
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)",
			"padding": {
				"left": "clamp(1.25rem, 5vw, 3rem)",
				"right": "clamp(1.25rem, 5vw, 3rem)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent-bright)" },
				"typography": { "textDecoration": "none" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--contrast)" },
					"typography": { "textDecoration": "underline" }
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.05",
					"textTransform": "uppercase",
					"letterSpacing": "0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "1.0625rem",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.06em"
				},
				"border": { "radius": "2px" },
				"spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.75rem", "right": "1.75rem" } },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-bright)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/image": {
				"border": { "radius": "3px" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--surface-raised)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": []
}
